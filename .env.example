# pre-kompl — copy to `.env` and fill in real values.
# `.env` is gitignored; this file is the template.

# YouTube Data API v3 — https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Without this, YouTube bookmarks ingest as partial / missing_api_key.
YOUTUBE_API_KEY=

# GitHub personal access token — `gh auth token` if GitHub CLI is logged in,
# or create at https://github.com/settings/tokens (needs `repo` for private repos).
# Without this, GitHub bookmarks ingest as partial / missing_api_key.
GITHUB_TOKEN=

# Firecrawl v2 — https://docs.firecrawl.dev/
# Enables JS-rendered rescue for blocked/failed web URLs during ingest.
FIRECRAWL_API_KEY=

# Max Firecrawl credits per ingest run (default 500 = free-tier monthly cap).
FIRECRAWL_BUDGET=500

# Optional overrides (defaults shown):
# PRE_KOMPL_HOME=~/.pre-kompl
# PRE_KOMPL_DB=~/.pre-kompl/catalog.db
