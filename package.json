{
  "name": "pre-kompl",
  "version": "0.1.0",
  "description": "Local, searchable catalog of your saved bookmarks across YouTube, GitHub, X/Twitter and the web.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuirk/pre-Kompl.git"
  },
  "type": "module",
  "bin": {
    "pre-kompl": "bin/pre-kompl.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ingest": "tsx --no-warnings src/cli.ts ingest",
    "status": "tsx --no-warnings src/cli.ts status",
    "errors": "tsx --no-warnings src/cli.ts errors",
    "partials": "tsx --no-warnings src/cli.ts partials",
    "cli": "tsx --no-warnings src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
